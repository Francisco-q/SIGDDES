# ========================================
# CONFIGURACIÓN DE ENTORNO - SAFEVG FRONTEND
# ========================================
# 
# INSTRUCCIONES:
# 1. Copia este archivo como .env (sin .example)
# 2. Rellena las variables con tus valores reales
# 3. NUNCA commitees el archivo .env al repositorio
# 
# ========================================

# ----------------------------------------
# DESARROLLO LOCAL
# ----------------------------------------
# URL del backend en desarrollo local
VITE_API_BASE_URL=http://localhost:8000

# URL del frontend en desarrollo local
VITE_FRONTEND_BASE_URL=http://localhost:5173

# ----------------------------------------
# PRODUCCIÓN (Configurar en Vercel/Netlify)
# ----------------------------------------
# Estas variables se configuran en el panel de tu hosting,
# NO las pongas aquí con valores reales

# URL del backend en producción
# VITE_API_BASE_URL=https://tu-backend.onrender.com

# URL del frontend en producción  
# VITE_FRONTEND_BASE_URL=https://tu-frontend.vercel.app

# ----------------------------------------
# CONFIGURACIONES OPCIONALES
# ----------------------------------------
# Habilitar/deshabilitar features en desarrollo
# VITE_ENABLE_ANALYTICS=false
# VITE_DEBUG_MODE=true
# VITE_MOCK_API=false

# ----------------------------------------
# NOTAS DE SEGURIDAD
# ----------------------------------------
# - Variables VITE_ son públicas (visibles en el navegador)
# - No incluyas API keys, passwords, o datos sensibles aquí
# - Los secretos van en el backend, no en el frontend
# - En producción, configura estas variables en tu plataforma de hosting

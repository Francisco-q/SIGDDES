# ========================================
# CONFIGURACIÓN DE ENTORNO - SAFEVG BACKEND
# ========================================
# 
# INSTRUCCIONES:
# 1. Copia este archivo como .env (sin .example)
# 2. Rellena las variables con tus valores reales
# 3. NUNCA commitees el archivo .env al repositorio
# 
# ========================================

# ----------------------------------------
# DJANGO CONFIGURACIÓN BÁSICA
# ----------------------------------------
# Clave secreta de Django (generar una nueva para producción)
SECRET_KEY=tu-secret-key-super-segura-de-50-caracteres-minimo

# Entorno de ejecución (True solo para desarrollo)
DEBUG=True

# Módulo de configuración a usar
DJANGO_SETTINGS_MODULE=django_crud_api.settings

# ----------------------------------------
# BASE DE DATOS
# ----------------------------------------
# Configuración para PostgreSQL (recomendado para producción)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=safevg_local
DB_USER=postgres
DB_PASSWORD=tu_password_db
DB_HOST=localhost
DB_PORT=5432

# Para desarrollo local con SQLite (comentar las de arriba):
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# ----------------------------------------
# FRONTEND Y CORS
# ----------------------------------------
# URL del frontend para configurar CORS
FRONTEND_URL=http://localhost:5173

# URLs adicionales permitidas (separadas por coma)
# ADDITIONAL_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5173

# ----------------------------------------
# INTEGRACIÓN JIRA (OPCIONAL)
# ----------------------------------------
# Configuración para integración con Jira
JIRA_API_URL=https://tu-empresa.atlassian.net
JIRA_EMAIL=tu-email@empresa.com
JIRA_API_TOKEN=tu-token-de-jira
JIRA_PROJECT_KEY=SAFEVG

# ----------------------------------------
# EMAIL (OPCIONAL)
# ----------------------------------------
# Configuración para envío de emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password

# ----------------------------------------
# CONFIGURACIONES DE PRODUCCIÓN
# ----------------------------------------
# Host permitido en producción
PRODUCTION_HOST=tu-dominio.com

# Configuración de archivos estáticos en producción
# STATIC_URL=/static/
# MEDIA_URL=/media/

# ----------------------------------------
# SEGURIDAD ADICIONAL
# ----------------------------------------
# Configuraciones adicionales de seguridad para producción
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# ----------------------------------------
# NOTAS DE SEGURIDAD
# ----------------------------------------
# - Genera un SECRET_KEY único: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# - Usa contraseñas fuertes para la base de datos
# - En producción, estas variables se configuran en tu servidor
# - Nunca expongas credenciales reales en este archivo

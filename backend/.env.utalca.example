# Copiar como backend/.env.utalca y completar únicamente en la VM.
# No almacenar credenciales reales en Git.
DJANGO_SETTINGS_MODULE=django_crud_api.settings_utalca
SECRET_KEY=cambiar-por-una-clave-generada-de-al-menos-50-caracteres
DEBUG=False

ORACLE_HOST=host-oracle-interno
ORACLE_PORT=1521
ORACLE_SID=sid_asignado
ORACLE_USER=usuario_del_esquema
ORACLE_PASSWORD=clave_del_esquema
DB_CONN_MAX_AGE=60

ALLOWED_HOSTS=localhost,127.0.0.1,nombre-vm,ip-privada-vm
FRONTEND_BASE_URL=http://ip-o-dominio-de-la-vm
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Activar estas opciones cuando TI habilite HTTPS.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
LOG_LEVEL=INFO

# Integración opcional. Pueden permanecer vacías en DEV.
JIRA_API_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
